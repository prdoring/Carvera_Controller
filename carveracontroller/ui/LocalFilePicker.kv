#:import theme carveracontroller.ui.theme
#:import tr carveracontroller.__main__.tr

<LocalFilePickerDirButton>:
    orientation: 'horizontal'
    spacing: dp(4)
    padding: dp(4), dp(6)
    canvas.before:
        Color:
            rgba: theme.CONTROL
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        size_hint_x: None
        width: dp(16)
        canvas.before:
            Color:
                rgba: theme.TEXT
            Rectangle:
                source: 'data/connected.png'
                pos: self.center_x - dp(8), self.center_y - dp(8)
                size: dp(16), dp(16)
    Image:
        size_hint_x: None
        width: dp(18)
        height: dp(18)
        allow_stretch: True
        keep_ratio: True
        source: 'data/folder-32.png'
    Label:
        text: root.data_text
        shorten: True
        shorten_from: 'right'
        halign: 'left'
        valign: 'middle'
        text_size: self.width, None
        color: theme.TEXT

<LocalFilePickerSheet>:
    orientation: 'vertical'
    padding: dp(8)
    spacing: dp(8)
    TouchActionRow:
        size_hint_y: None
        height: app.touch_target if app.android_touch else dp(40)
        spacing: dp(8)
        LocalFilePickerDirButton:
            id: dir_btn
            data_text: root.curr_dir_name
            size_hint_x: None
            width: dp(144)
            on_release: root.open_dir_dropdown(self)
        Button:
            text: tr._('Folder details') if app.android_touch else root.ids.fc.path
            shorten: True
            text_size: self.width - dp(16), None
            on_release: root.show_folder_path()
        Button:
            text: tr._('Storage')
            size_hint_x: None
            width: dp(104) if app.android_touch else 0
            opacity: 1 if app.android_touch else 0
            disabled: not app.android_touch
            on_release: root.show_storage_access()
    TouchFileChooserListView:
        id: fc
    DialogLabel:
        text: tr._('Filename') if app.android_touch else ''
        text_role: 'secondary'
        size_hint_y: None
        height: self.texture_size[1] + dp(8) if app.android_touch else 0
    EditingTextInput:
        id: ti_filename
        hint_text: tr._('File name')
        input_policy: 'filename'
        multiline: False
        size_hint_y: None
        height: app.touch_target if app.android_touch else dp(40)
    DialogActions:
        spacing: dp(8)
        Button:
            id: btn_cancel
            text: tr._('Cancel')
        Button:
            id: btn_confirm
            text: tr._('Save')
