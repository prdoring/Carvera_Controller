#:import theme carveracontroller.ui.theme
#:import tr carveracontroller.__main__.tr
#:import HEADER_HEIGHT carveracontroller.ui.GcodeColorSchemePanel.HEADER_HEIGHT
#:import PANEL_BOTTOM_PADDING carveracontroller.ui.GcodeColorSchemePanel.PANEL_BOTTOM_PADDING

<GcodeColorSchemePanel>:
    orientation: 'vertical'
    size_hint: None, None
    width: dp(270)
    height: 0 if not app.show_gcode_ctl_bar or (app.android_touch and not app.show_legend) else (legend_header.height + PANEL_BOTTOM_PADDING + legend_scroll.height)
    opacity: 1 if app.show_gcode_ctl_bar and (not app.android_touch or app.show_legend) else 0
    disabled: not app.show_gcode_ctl_bar or (app.android_touch and not app.show_legend) or (app.selected_remote_filename == '' and app.selected_local_filename == '')
    pos_hint: {'right': 1.0, 'top': 1.0}
    padding: 0, 0, 0, dp(6)
    spacing: 0
    canvas.before:
        Color:
            rgba: (*theme.FIELD[:3], 0.5)
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        id: legend_header
        size_hint_y: None
        height: app.touch_target if app.android_touch else dp(36)
        spacing: dp(6)
        padding: dp(6), dp(4)
        canvas.before:
            Color:
                rgba: theme.CONTROL
            Rectangle:
                pos: self.pos
                size: self.size
        Spinner:
            id: gcode_color_scheme_spinner
            text: tr._('Tool')
            values: tr._('Tool'), tr._('Move type'), tr._('Speed'), tr._('Height')
            size_hint_x: 1
            on_text:
                app.root.on_gcode_color_scheme_changed(self.text)
        TransparentGrayButton:
            id: visibility_toggle
            size_hint: None, None
            width: dp(32)
            height: app.touch_target if app.android_touch else dp(28)
            icon: 'data/eye.png'
            icon_size: 18
            active: root.any_visible
            disabled: root.disabled
            on_release:
                app.root.toggle_gcode_visibility_all()
    ScrollView:
        id: legend_scroll
        size_hint_y: None
        do_scroll_x: False
        bar_width: dp(5)
        bar_color: (*theme.BORDER[:3], 0.8)
        bar_inactive_color: (*theme.CONTROL[:3], 0.5)
        BoxLayout:
            id: legend_box
            orientation: 'vertical'
            size_hint_x: 1
            size_hint_y: None
            spacing: dp(2)
            padding: dp(8), dp(4), dp(8), dp(2)
