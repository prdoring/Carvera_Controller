#:import tr carveracontroller.__main__.tr
#:import default_values carveracontroller.addons.facing.facing_wizard_defaults

<FacingGcodePreviewLine@Label>:
    markup: True
    font_size: '16sp' if app.android_touch else dp(14)
    size_hint_y: None
    height: app.touch_target if app.android_touch else dp(24)
    shorten: False
    text_size: self.width - dp(16), None
    padding_x: dp(10)
    padding_y: dp(2)
    halign: 'left'
    valign: 'middle'
    color: 200/255, 200/255, 200/255, 1

<FacingSavePresetContent>:
    orientation: 'vertical'
    size_hint: 1, None
    height: self.minimum_height
    padding: dp(14)
    spacing: dp(8)
    Label:
        text: tr._('Preset name')
        size_hint_y: None
        height: self.texture_size[1] + dp(2)
        font_size: '16sp' if app.android_touch else dp(12)
        text_size: self.width, None
        halign: 'left'
        valign: 'bottom'
        color: 0.78, 0.79, 0.82, 1
    EditingTextInput:
        id: ti_name
        input_policy: 'filename'
        size_hint_y: None
        height: app.touch_target if app.android_touch else dp(40)
        multiline: False
    BoxLayout:
        size_hint_y: None
        height: app.touch_target if app.android_touch else dp(44)
        spacing: dp(8)
        Button:
            id: btn_cancel
            text: tr._('Cancel')
        Button:
            id: btn_save
            text: tr._('Save')

<FacingWizardPopup>:
    title: tr._('Facing wizard')
    size_hint: 0.88, 0.9
    pos_hint: {'center_x': 0.5, 'center_y': 0.5}
    auto_dismiss: False
    overlay_color: 0, 0, 0, 0.35

    BoxLayout:
        orientation: 'vertical'
        padding: dp(8)
        spacing: dp(8)

        TouchActionRow:
            height: self.minimum_height if app.android_touch else 0
            opacity: 1 if app.android_touch else 0
            disabled: not app.android_touch
            spacing: dp(6)
            ToggleButton:
                text: tr._('Help text')
                on_release: root.show_form_help = self.state == 'down'
            ToggleButton:
                text: tr._('Sketch')
                on_release: root.show_sketch = self.state == 'down'
            ToggleButton:
                text: tr._('G-code preview')
                on_release: root.show_gcode_preview = self.state == 'down'
        DialogLabel:
            text: root.program_state
            height: self.texture_size[1] + dp(8)
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_y: 1

            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 1 if app.android_touch else 0.44
                spacing: dp(6)

                TabbedPanel:
                    size_hint_y: 1 if app.android_touch else 0.57
                    do_default_tab: False
                    tab_width: dp(120)
                    bar_width: dp(8)
                    bar_color: 0.85, 0.25, 0.2, 1
                    padding: dp(8), dp(8), dp(8), dp(10)

                    TouchTabbedPanelItem:
                        text: tr._('Stock')
                        ScrollView:
                            scroll_type: ['bars', 'content']
                            bar_width: dp(14)
                            padding: dp(16), dp(10), dp(22), dp(14)
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: self.padding[1] + self.padding[3] + stock_tab_help.height + stock_tab_fields.height + self.spacing
                                spacing: dp(12)
                                padding: [dp(14), dp(10), dp(16), dp(12)]

                                Label:
                                    id: stock_tab_help
                                    size_hint_y: None
                                    size_hint_x: 1
                                    font_size: '16sp' if app.android_touch else dp(14)
                                    line_spacing: dp(5)
                                    color: 0.72, 0.73, 0.76, 1
                                    text_size: self.width, None
                                    halign: 'left'
                                    valign: 'top'
                                    multiline: True
                                    text: tr._('Measure your stock and pick the corner where X0 Y0 sits—the point you touched off when setting work zero. Width runs along X and length along Y from that corner. Margins pad the outline outward so facing and probing keep a safe distance from the edges. Extra depth removes a bit more material downward on top of the facing depth. Clearance height is how high the spindle travels between moves. If you enable Z grid probing on the Z probe grid tab, the machine checks the surface first; after you swap to your facing tool, Z zero is aligned to the highest spot the probe found.')
                                    height: max(dp(60), self.texture_size[1] + dp(10)) if not app.android_touch or root.show_form_help else 0
                                    opacity: 1 if not app.android_touch or root.show_form_help else 0

                                GridLayout:
                                    id: stock_tab_fields
                                    cols: 2
                                    size_hint_y: None
                                    height: self.minimum_height
                                    row_default_height: app.touch_target if app.android_touch else dp(40)
                                    spacing: dp(4)

                                    Label:
                                        text: tr._('WCS origin corner')
                                    Spinner:
                                        id: spn_stock_corner
                                        values: ['']
                                        text: ''
                                        size_hint_y: None
                                        height: app.touch_target if app.android_touch else dp(40)
                                    Label:
                                        text: tr._('Width (mm)')
                                    EditingTextInput:
                                        id: txt_w
                                        text: default_values.DEFAULT_TXT['txt_w']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Length (mm)')
                                    EditingTextInput:
                                        id: txt_l
                                        text: default_values.DEFAULT_TXT['txt_l']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Margin ±X (mm)')
                                    EditingTextInput:
                                        id: txt_mx
                                        text: default_values.DEFAULT_TXT['txt_mx']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Margin ±Y (mm)')
                                    EditingTextInput:
                                        id: txt_my
                                        text: default_values.DEFAULT_TXT['txt_my']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Extra depth (mm)')
                                    EditingTextInput:
                                        id: txt_mz
                                        text: default_values.DEFAULT_TXT['txt_mz']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Clearance Z (mm)')
                                    EditingTextInput:
                                        id: txt_clear
                                        text: default_values.DEFAULT_TXT['txt_clear']
                                        multiline: False
                                        input_filter: 'float'

                    TouchTabbedPanelItem:
                        text: tr._('Cutting')
                        ScrollView:
                            scroll_type: ['bars', 'content']
                            bar_width: dp(14)
                            padding: dp(16), dp(10), dp(22), dp(14)
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: self.padding[1] + self.padding[3] + cutting_tab_help.height + cutting_tab_fields.height + self.spacing
                                spacing: dp(12)
                                padding: [dp(14), dp(10), dp(16), dp(12)]

                                Label:
                                    id: cutting_tab_help
                                    size_hint_y: None
                                    size_hint_x: 1
                                    font_size: '16sp' if app.android_touch else dp(14)
                                    line_spacing: dp(5)
                                    color: 0.72, 0.73, 0.76, 1
                                    text_size: self.width, None
                                    halign: 'left'
                                    valign: 'top'
                                    multiline: True
                                    text: tr._('Roughing clears material in layers using stepover, depth per pass, and total rough depth (combine with Extra depth on Stock if you need more Z). Turn on Finish for a light cleanup pass at the end. Pattern picks raster (Along X or Along Y) or an outside-in spiral.')
                                    height: max(dp(60), self.texture_size[1] + dp(10)) if not app.android_touch or root.show_form_help else 0
                                    opacity: 1 if not app.android_touch or root.show_form_help else 0

                                GridLayout:
                                    id: cutting_tab_fields
                                    cols: 2
                                    size_hint_y: None
                                    height: self.minimum_height
                                    row_default_height: app.touch_target if app.android_touch else dp(40)
                                    spacing: dp(4)

                                    Label:
                                        text: tr._('Spindle RPM')
                                    EditingTextInput:
                                        id: txt_spindle
                                        text: default_values.DEFAULT_TXT['txt_spindle']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Spindle dwell (s)')
                                    EditingTextInput:
                                        id: txt_spindle_dwell
                                        text: default_values.DEFAULT_TXT['txt_spindle_dwell']
                                        multiline: False
                                        input_filter: 'int'

                                    Label:
                                        text: tr._('Pattern')
                                    BoxLayout:
                                        TouchToggleButton:
                                            id: raster_x_btn
                                            text: tr._('Along X')
                                            group: 'facing_pattern'
                                            state: 'down'
                                        TouchToggleButton:
                                            id: raster_y_btn
                                            text: tr._('Along Y')
                                            group: 'facing_pattern'
                                        TouchToggleButton:
                                            id: raster_spiral_btn
                                            text: tr._('Spiral')
                                            group: 'facing_pattern'

                                    Label:
                                        text: tr._('Milling')
                                    Spinner:
                                        id: spn_milling_dir
                                        values: ['']
                                        text: ''
                                        size_hint_y: None
                                        height: app.touch_target if app.android_touch else dp(40)
                                    Label:
                                        text: tr._('Rough feed (mm/min)')
                                    EditingTextInput:
                                        id: txt_rough_f
                                        text: default_values.DEFAULT_TXT['txt_rough_f']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Rough plunge (mm/min)')
                                    EditingTextInput:
                                        id: txt_rough_plunge
                                        text: default_values.DEFAULT_TXT['txt_rough_plunge']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Rough stepover (mm)')
                                    EditingTextInput:
                                        id: txt_rough_step
                                        text: default_values.DEFAULT_TXT['txt_rough_step']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Rough depth/pass (mm)')
                                    EditingTextInput:
                                        id: txt_rough_doc
                                        text: default_values.DEFAULT_TXT['txt_rough_doc']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Rough total depth (mm)')
                                    EditingTextInput:
                                        id: txt_rough_total
                                        text: default_values.DEFAULT_TXT['txt_rough_total']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Finish pass')
                                    TouchCheckBox:
                                        id: chk_finish
                                        active: default_values.DEFAULT_CHK_FINISH
                                        size_hint_x: 0.3

                                    Label:
                                        text: tr._('Finish feed (mm/min)')
                                    EditingTextInput:
                                        id: txt_finish_f
                                        text: default_values.DEFAULT_TXT['txt_finish_f']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Finish stepover (mm)')
                                    EditingTextInput:
                                        id: txt_finish_step
                                        text: default_values.DEFAULT_TXT['txt_finish_step']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Finish extra depth (mm)')
                                    EditingTextInput:
                                        id: txt_finish_depth
                                        text: default_values.DEFAULT_TXT['txt_finish_depth']
                                        multiline: False
                                        input_filter: 'float'

                    TouchTabbedPanelItem:
                        text: tr._('Z probe grid')
                        ScrollView:
                            scroll_type: ['bars', 'content']
                            bar_width: dp(14)
                            padding: dp(16), dp(10), dp(22), dp(14)
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: self.padding[1] + self.padding[3] + probe_tab_help.height + probe_tab_fields.height + self.spacing
                                spacing: dp(12)
                                padding: [dp(14), dp(10), dp(16), dp(12)]

                                Label:
                                    id: probe_tab_help
                                    size_hint_y: None
                                    size_hint_x: 1
                                    font_size: '16sp' if app.android_touch else dp(14)
                                    line_spacing: dp(5)
                                    color: 0.72, 0.73, 0.76, 1
                                    text_size: self.width, None
                                    halign: 'left'
                                    valign: 'top'
                                    multiline: True
                                    text: tr._('Turn on Include Z grid probe with the checkbox below; layout matches the origin corner from the Stock tab. The machine taps the surface on a grid to map height. Probe Z travel must stay negative so the probe searches downward. Grid inset pulls probe points slightly inside the gray stock outline (not inside the dashed margin ring). After probing and loading your facing tool, Z zero is adjusted so the tallest measured spot is treated as the top surface for facing.')
                                    height: max(dp(60), self.texture_size[1] + dp(10)) if not app.android_touch or root.show_form_help else 0
                                    opacity: 1 if not app.android_touch or root.show_form_help else 0

                                GridLayout:
                                    id: probe_tab_fields
                                    cols: 2
                                    size_hint_y: None
                                    height: self.minimum_height
                                    row_default_height: app.touch_target if app.android_touch else dp(40)
                                    spacing: dp(4)

                                    Label:
                                        text: tr._('Include Z grid probe')
                                    TouchCheckBox:
                                        id: chk_probe
                                        active: default_values.DEFAULT_CHK_PROBE
                                        size_hint_x: 0.3

                                    Label:
                                        text: tr._('Probe')
                                    Spinner:
                                        id: spn_probe_tool
                                        values: ['']
                                        text: ''
                                        size_hint_y: None
                                        height: app.touch_target if app.android_touch else dp(40)
                                    Label:
                                        text: tr._('Grid NX')
                                    EditingTextInput:
                                        id: txt_grid_nx
                                        text: default_values.DEFAULT_TXT['txt_grid_nx']
                                        multiline: False
                                        input_filter: 'int'

                                    Label:
                                        text: tr._('Grid NY')
                                    EditingTextInput:
                                        id: txt_grid_ny
                                        text: default_values.DEFAULT_TXT['txt_grid_ny']
                                        multiline: False
                                        input_filter: 'int'

                                    Label:
                                        text: tr._('Probe approach Z (mm)')
                                    EditingTextInput:
                                        id: txt_probe_approach
                                        text: default_values.DEFAULT_TXT['txt_probe_approach']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Probe Z travel (mm)')
                                    EditingTextInput:
                                        id: txt_probe_travel
                                        text: default_values.DEFAULT_TXT['txt_probe_travel']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Probe feed (mm/min)')
                                    EditingTextInput:
                                        id: txt_probe_f
                                        text: default_values.DEFAULT_TXT['txt_probe_f']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Grid inset (mm)')
                                    EditingTextInput:
                                        id: txt_probe_inset
                                        text: default_values.DEFAULT_TXT['txt_probe_inset']
                                        multiline: False
                                        hint_text: tr._('Inset from the stock outline')
                                        input_filter: 'float'

                    TouchTabbedPanelItem:
                        text: tr._('Tool / Misc.')
                        ScrollView:
                            scroll_type: ['bars', 'content']
                            bar_width: dp(14)
                            padding: dp(16), dp(10), dp(22), dp(14)
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: self.padding[1] + self.padding[3] + tool_tab_help.height + tool_tab_fields.height + self.spacing
                                spacing: dp(12)
                                padding: [dp(14), dp(10), dp(16), dp(12)]

                                Label:
                                    id: tool_tab_help
                                    size_hint_y: None
                                    size_hint_x: 1
                                    font_size: '16sp' if app.android_touch else dp(14)
                                    line_spacing: dp(5)
                                    color: 0.72, 0.73, 0.76, 1
                                    text_size: self.width, None
                                    halign: 'left'
                                    valign: 'top'
                                    multiline: True
                                    text: tr._('This section loads your facing bit before cutting starts. Without probing it runs at the top of the program; with Z grid probing it runs after the probe cycle. Enter the facing tool number and ATC collet size when your machine needs them. The optional fields are for advanced setups such as repeating a tool-length touch-off or applying setter offsets.')
                                    height: max(dp(60), self.texture_size[1] + dp(10)) if not app.android_touch or root.show_form_help else 0
                                    opacity: 1 if not app.android_touch or root.show_form_help else 0

                                GridLayout:
                                    id: tool_tab_fields
                                    cols: 2
                                    size_hint_y: None
                                    height: self.minimum_height
                                    row_default_height: app.touch_target if app.android_touch else dp(40)
                                    spacing: dp(4)

                                    Label:
                                        text: tr._('Facing tool T')
                                    EditingTextInput:
                                        id: txt_m6_t
                                        text: default_values.DEFAULT_TXT['txt_m6_t']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Facing tool diameter (mm)')
                                    EditingTextInput:
                                        id: txt_tool_d
                                        text: default_values.DEFAULT_TXT['txt_tool_d']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Collet size (ATC)')
                                    Spinner:
                                        id: spn_m6_collet
                                        values: ['']
                                        text: ''
                                        size_hint_y: None
                                        height: app.touch_target if app.android_touch else dp(40)
                                    Label:
                                        text: tr._('TLO repeats (optional)')
                                    EditingTextInput:
                                        id: txt_tlo_r
                                        text: default_values.DEFAULT_TXT['txt_tlo_r']
                                        multiline: False
                                        input_filter: 'int'

                                    Label:
                                        text: tr._('Setter offset X (mm)')
                                    EditingTextInput:
                                        id: txt_m491_x
                                        text: default_values.DEFAULT_TXT['txt_m491_x']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Setter offset Y (mm)')
                                    EditingTextInput:
                                        id: txt_m491_y
                                        text: default_values.DEFAULT_TXT['txt_m491_y']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Setter offset Z (mm)')
                                    EditingTextInput:
                                        id: txt_m491_z
                                        text: default_values.DEFAULT_TXT['txt_m491_z']
                                        multiline: False
                                        input_filter: 'float'

                                    Label:
                                        text: tr._('Ext. port (vacuum, coolant, …)')
                                    TouchCheckBox:
                                        id: chk_ext_port
                                        active: default_values.DEFAULT_CHK_EXT_PORT
                                        size_hint_x: 0.3

                                    Label:
                                        text: tr._('Ext. port PWM %')
                                    EditingTextInput:
                                        id: txt_ext_port_s
                                        text: default_values.DEFAULT_TXT['txt_ext_port_s']
                                        multiline: False
                                        hint_text: tr._('0–100')
                                        input_filter: 'int'

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None if app.android_touch else 0.43
                    height: dp(220) if root.show_sketch or not app.android_touch else 0
                    opacity: 1 if root.show_sketch or not app.android_touch else 0
                    disabled: app.android_touch and not root.show_sketch
                    spacing: dp(4)
                    padding: dp(8), dp(2), dp(8), dp(0)

                    FacingSketch:
                        id: facing_preview_sketch
                        size_hint_y: 1
                        size_hint_min_y: dp(120)

                    Label:
                        id: lbl_preview_error
                        size_hint_y: None
                        height: app.touch_target if app.android_touch else dp(22)
                        font_size: '16sp' if app.android_touch else dp(10)
                        text_size: self.width, None
                        halign: 'center'
                        valign: 'middle'
                        shorten: True
                        max_lines: 2
                        multiline: True
                        text: ''
                        color: 0.92, 0.42, 0.35, 1

                    Label:
                        size_hint_y: None
                        height: self.texture_size[1] + dp(6)
                        font_size: '16sp' if app.android_touch else dp(9)
                        text_size: self.width - dp(8), None
                        halign: 'center'
                        valign: 'top'
                        color: 0.65, 0.66, 0.7, 1
                        text: tr._('Gray solid: stock outline · Dashed ring: margin · Red: facing path · Blue: probe grid (inset from stock edge) · Bright marker: X Y zero')

            BoxLayout:
                orientation: 'vertical'
                size_hint_x: (1 if root.show_gcode_preview else None) if app.android_touch else 0.56
                width: 0 if app.android_touch and not root.show_gcode_preview else dp(400)
                opacity: 0 if app.android_touch and not root.show_gcode_preview else 1
                disabled: app.android_touch and not root.show_gcode_preview
                spacing: dp(6)
                padding: dp(8), dp(6), dp(8), dp(4)

                Label:
                    size_hint_y: None
                    font_size: '16sp' if app.android_touch else dp(13)
                    color: 0.7, 0.71, 0.74, 1
                    text_size: self.width, None
                    halign: 'left'
                    valign: 'middle'
                    text: tr._('G-code preview')
                    height: self.texture_size[1] + dp(8)

                BoxLayout:
                    size_hint_y: 1
                    canvas.before:
                        Color:
                            rgba: 35/255, 35/255, 35/255, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    RecycleView:
                        id: rv_gcode_preview
                        viewclass: 'FacingGcodePreviewLine'
                        scroll_type: ['bars', 'content']
                        bar_width: dp(14)
                        scroll_wheel_distance: dp(80)
                        RecycleBoxLayout:
                            default_size: None, dp(24)
                            default_size_hint: 1, None
                            size_hint_y: None
                            height: self.minimum_height
                            orientation: 'vertical'
                            spacing: 0

        # Footer
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height if app.android_touch else dp(60)
            padding: dp(6), dp(4), dp(6), dp(8)
            spacing: dp(6)
            canvas.before:
                Color:
                    rgba: 0.22, 0.22, 0.24, 1
                Rectangle:
                    pos: self.pos[0], self.pos[1] + self.height - dp(1)
                    size: self.width, dp(1)

            TouchActionRow:
                spacing: dp(10)
                size_hint_y: None
                height: app.touch_target if app.android_touch else dp(44)
                Button:
                    id: btn_presets_menu
                    size_hint_x: 1
                    font_size: '16sp' if app.android_touch else dp(12)
                    text: tr._('Presets')
                    on_release: root.open_presets_menu(btn_presets_menu)
                Button:
                    id: btn_generate_program
                    size_hint_x: 1
                    font_size: '16sp' if app.android_touch else dp(12)
                    text: tr._('Generate')
                    on_release: root.generate_program()
                Button:
                    id: btn_gcode_menu
                    size_hint_x: 1
                    font_size: '16sp' if app.android_touch else dp(12)
                    text: tr._('G-code')
                    on_release: root.open_gcode_menu(btn_gcode_menu)
                Button:
                    size_hint_x: 1
                    font_size: '16sp' if app.android_touch else dp(12)
                    text: tr._('Close')
                    on_release: root.dismiss()

                HelpButton:
                    helpPath: "https://carvera-community.gitbook.io/docs/controller/features/facing-widget"
